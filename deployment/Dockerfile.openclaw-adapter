FROM node:22-bookworm-slim AS build

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.18.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json .prettierrc ./
COPY apps ./apps
COPY packages ./packages
COPY services ./services
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @casioplus/openclaw-adapter build
RUN pnpm --filter @casioplus/openclaw-adapter deploy --prod /out

FROM node:22.22.3-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
RUN npm install --global --omit=dev openclaw@2026.7.1-2 \
  && npm cache clean --force
COPY --from=build /workspace/services/openclaw-adapter/dist ./dist
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /out/package.json ./package.json
USER node
CMD ["node", "dist/server.js"]
