NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://casioplus:casioplus@127.0.0.1:5432/casioplus
DATABASE_MAX_CONNECTIONS=16
MIGRATIONS_DIR=./migrations

# Identity and tenant boundary
SESSION_SECRET=replace-with-a-long-random-value
# Local-only smoke compatibility; never enable in staging or production.
ALLOW_DEV_TENANT_HEADERS=false
CASIOPLUS_COOKIE_DOMAIN=.casioplus.com
CONSOLE_HOSTNAME=console.casioplus.com
FORGE_HOSTNAME=forge.casioplus.com
CASIOPLUS_CONSOLE_URL=http://localhost:5173
CASIOPLUS_FORGE_URL=http://localhost:5174
CASIOPLUS_CORE_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Runtime boundaries; disabled until configured and verified
REDIS_URL=redis://127.0.0.1:6379
N8N_ENABLED=false
OPEN_WEBUI_ENABLED=false
OPENCLAW_ENABLED=false
N8N_BASE_URL=
OPEN_WEBUI_BASE_URL=
OPENCLAW_BASE_URL=
RUNTIME_SHARED_SECRET=replace-with-a-long-random-value
DISPATCHER_SHARED_SECRET=replace-with-a-different-long-random-value
INTEGRATION_HMAC_SECRETS_JSON={}
CORE_API_URL=http://core-api:8080
N8N_ADAPTER_URL=http://n8n-adapter:8080
OPEN_WEBUI_ADAPTER_URL=http://open-webui-adapter:8080
OPENCLAW_ADAPTER_URL=http://openclaw-adapter:8080
NATIVE_WORKER_PORT=8090
NATIVE_WORKER_URL=http://native-diagnosis-worker:8090
NATIVE_WORKER_TIMEOUT_MS=30000
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
