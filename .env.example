NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://casioplus:casioplus@127.0.0.1:5432/casioplus
DATABASE_MAX_CONNECTIONS=16
MIGRATIONS_DIR=./migrations

# Identity and tenant boundary
SESSION_SECRET=replace-with-a-long-random-value
# Local-only smoke compatibility; never enable in staging or production.
ALLOW_DEV_TENANT_HEADERS=false
CASIOPLUS_COOKIE_DOMAIN=.casioplus.com
CONSOLE_HOSTNAME=console.casioplus.com
FORGE_HOSTNAME=forge.casioplus.com
CASIOPLUS_CONSOLE_URL=http://localhost:5173
CASIOPLUS_FORGE_URL=http://localhost:5174
CASIOPLUS_CORE_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Runtime boundaries; disabled until configured and verified
REDIS_URL=redis://127.0.0.1:6379
N8N_ENABLED=false
OPEN_WEBUI_ENABLED=false
OPENCLAW_ENABLED=false
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook/casioplus-runtime-execution
N8N_WEBHOOK_TOKEN=replace-with-a-dedicated-n8n-header-token
N8N_WEBHOOK_TIMEOUT_MS=60000
N8N_RUNTIME_TIMEOUT_MS=60000
OPEN_WEBUI_API_URL=http://open-webui:8080
OPEN_WEBUI_API_KEY=replace-with-a-dedicated-non-admin-service-account-key
OPEN_WEBUI_ALLOWED_MODELS_JSON=["casioplus-general"]
OPEN_WEBUI_TIMEOUT_MS=120000
OPEN_WEBUI_RUNTIME_TIMEOUT_MS=120000
OPEN_WEBUI_SECRET_KEY=replace-with-a-long-runtime-secret
OPENCLAW_GATEWAY_URL=ws://openclaw-gateway:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-a-dedicated-gateway-token
OPENCLAW_EXECUTOR_TARGETS_JSON={}
OPENCLAW_TIMEOUT_MS=60000
OPENCLAW_RUNTIME_TIMEOUT_MS=60000
GITHUB_APP_ADAPTER_URL=http://github-app-adapter:8085
CASIOPLUS_GITHUB_APP_INTERNAL_URL=http://github-app-adapter:8085
CASIOPLUS_CORE_INTERNAL_URL=http://core-api:8080
TRANSLATION_SCHEDULER_SECRET=replace-with-an-independent-scheduler-random-value
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_INSTALLATION_ID=replace-with-installation-id
GITHUB_APP_PRIVATE_KEY_BASE64=replace-with-base64-pem-private-key
GITHUB_APP_WEBHOOK_SECRET=replace-with-a-dedicated-github-webhook-secret
GITHUB_APP_REQUEST_TIMEOUT_MS=30000
GITHUB_INTEGRATION_EXTERNAL_APP_KEY=github-app
GITHUB_INTEGRATION_EXTERNAL_TENANT_REF=hadiranweb
GITHUB_INTEGRATION_EXTERNAL_WORKSPACE_REF=casio-plus-final
GITHUB_INTEGRATION_KEY_ID=github-app-v1
GITHUB_INTEGRATION_SIGNING_SECRET=replace-with-a-rotatable-integration-hmac-secret
CASIOPLUS_INTEGRATION_NETWORK=casioplus-integration
RUNTIME_SHARED_SECRET=replace-with-a-long-random-value
DISPATCHER_SHARED_SECRET=replace-with-a-different-long-random-value
ADAPTER_SHARED_SECRET=replace-with-an-independent-adapter-random-value
INTEGRATION_HMAC_SECRETS_JSON={}
CORE_API_URL=http://core-api:8080
N8N_ADAPTER_URL=http://n8n-adapter:8082
OPEN_WEBUI_ADAPTER_URL=http://open-webui-adapter:8083
OPENCLAW_ADAPTER_URL=http://openclaw-adapter:8084
NATIVE_WORKER_PORT=8090
NATIVE_WORKER_URL=http://native-diagnosis-worker:8090
NATIVE_WORKER_TIMEOUT_MS=30000
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
