{
  "schemaVersion": "casioplus.n8n.manifest.v1",
  "n8nVersion": "2.36.8",
  "workflows": [
    {
      "path": "runtime/n8n/workflows/casioplus-runtime-execution.json",
      "name": "Casioplus Runtime Execution",
      "triggerType": "webhook",
      "webhookPath": "casioplus-runtime-execution",
      "operationPrefixes": ["n8n."],
      "activeInRepository": false,
      "requiredCredential": {
        "type": "httpHeaderAuth",
        "header": "Authorization",
        "secretEnvironmentVariable": "N8N_WEBHOOK_TOKEN"
      }
    },
    {
      "path": "runtime/n8n/workflows/casioplus-translation-proposal-schedule.json",
      "name": "Casioplus Translation Proposal Schedule",
      "triggerType": "schedule",
      "activeInRepository": false,
      "requiredEnvironmentVariables": [
        "CASIOPLUS_GITHUB_APP_INTERNAL_URL",
        "ADAPTER_SHARED_SECRET",
        "CASIOPLUS_CORE_INTERNAL_URL",
        "TRANSLATION_SCHEDULER_SECRET"
      ],
      "proposalOnly": true
    }
  ],
  "activationGates": [
    "repository-validation",
    "n8n-import-validation",
    "credential-binding",
    "environment-binding",
    "connection-review",
    "safe-test-execution",
    "first-execution-monitoring"
  ],
  "forbiddenNodeFamilies": [
    "n8n-nodes-base.postgres",
    "n8n-nodes-base.mysql",
    "n8n-nodes-base.mongoDb",
    "n8n-nodes-base.sqlite"
  ]
}
